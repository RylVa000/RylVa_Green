# =====================================================================
# KONFIGURASI LINGKUNGAN RYLVA GREEN v2.6 (LAMPIRAN A.10 & BAGIAN 15.7)
# Salin berkas ini menjadi config/.env (di luar folder public/)
# =====================================================================
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_BASE_URL=https://rylvagreen.id
STAFF_BASE_URL=https://rylvagreen.id/staff

# Koneksi Basis Data MySQL/InnoDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rylva_green
DB_USER=root
DB_PASSWORD=
AUDIT_DB_USER=rylva_audit_insert_only

# Kunci Kriptografi Aplikasi (32 byte hex/base64 untuk enkripsi rekening refund & MFA)
APP_KEY=
APP_KEY_PREVIOUS=
SESSION_SECRET=

# Keamanan Jaringan, Proxy & Rate Limit (Bagian 15.2, 15.3, 15.5)
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
STAFF_IP_ALLOWLIST=
RATE_LIMIT_ENABLED=true

# Integrasi Payment Gateway (D-11)
PAYMENT_PROVIDER=midtrans_or_xendit
PAYMENT_MODE=sandbox
PAYMENT_SERVER_KEY=
PAYMENT_WEBHOOK_SECRET=

# Integrasi Kurir / Agregator (D-06)
COURIER_PROVIDER=biteship_or_rajaongkir
COURIER_API_KEY=
COURIER_WEBHOOK_SECRET=

# Login Google OIDC (SEC-05 & Bagian 6.3.3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://rylvagreen.id/auth/google/callback

# Email Transaksional SMTP (D-10 & Bagian 14)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@rylvagreen.id

# Penyedia Anti-Bot CAPTCHA (RL-01 s.d. RL-03)
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Penyimpanan Berkas & Log di Luar Document Root (SEC-09 & Bagian 15.10)
UPLOAD_STORAGE_PATH=/var/www/rylva-green/storage/uploads
LOG_PATH=/var/www/rylva-green/storage/logs
LOG_LEVEL=info
ERROR_REPORTING=E_ALL

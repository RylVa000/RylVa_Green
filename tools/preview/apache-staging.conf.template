# Isolated Windows verification instance, generated by start-staging-apache.ps1.
ServerRoot "{{apacheRoot}}"
Listen 127.0.0.1:{{port}}
ServerName 127.0.0.1
PidFile "{{runtimeRoot}}/httpd.pid"
ServerTokens Prod
ServerSignature Off
LoadModule authn_core_module modules/mod_authn_core.so
LoadModule authn_file_module modules/mod_authn_file.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_user_module modules/mod_authz_user.so
LoadModule auth_basic_module modules/mod_auth_basic.so
LoadModule dir_module modules/mod_dir.so
LoadModule env_module modules/mod_env.so
LoadModule headers_module modules/mod_headers.so
LoadModule mime_module modules/mod_mime.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule php_module "{{phpRoot}}/php8apache2_4.dll"
PHPIniDir "{{phpRoot}}"
ErrorLog "{{runtimeRoot}}/apache-error.log"
LogLevel warn
TypesConfig "{{apacheRoot}}/conf/mime.types"
DocumentRoot "{{projectRoot}}/public"
DirectoryIndex index.php
SetEnv RYLVA_ENV_FILE "{{envFile}}"
SetEnv APP_ENV staging
SetEnv APP_DEBUG false
SetEnv APP_BASE_URL "http://127.0.0.1:{{port}}"
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Content-Type-Options "nosniff"
php_admin_flag display_errors Off
php_admin_flag expose_php Off
php_admin_flag log_errors On
php_admin_value error_log "{{runtimeRoot}}/php-error.log"
<Directory />
  AllowOverride None
  Require all denied
</Directory>
<Directory "{{projectRoot}}/public">
  Options +FollowSymLinks -Indexes -MultiViews
  AllowOverride FileInfo AuthConfig Options=Indexes,MultiViews,FollowSymLinks
  AuthType Basic
  AuthName "RylVa staging review"
  AuthBasicProvider file
  AuthUserFile "{{runtimeRoot}}/.htpasswd"
  Require valid-user
  <FilesMatch "\.php$">
    SetHandler application/x-httpd-php
  </FilesMatch>
</Directory>

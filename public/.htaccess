# Konfigurasi Keamanan Apache RylVa Green v2.6 (Bagian 15.9)
Options -Indexes -MultiViews
RewriteEngine On

# Blokir akses ke dotfile (.env, .git, dll.) kecuali .well-known
RewriteRule (^|/)\.(?!well-known) - [F,L]

# Blokir berkas sensitif bila tidak sengaja berada di document root
<FilesMatch "\.(sql|bak|log|ini|lock|md|sh)$">
    Require all denied
</FilesMatch>

# Arahkan seluruh permintaan ke front controller index.php
# Kompatibilitas alamat pratinjau HTML sebelum pemisahan folder halaman
RewriteRule ^(staff-login)\.html$ pages/auth/$1.html [R=302,L,NE]
RewriteRule ^(admin-dashboard|orders-queue|products|categories-attributes|production-materials|bouquet-production|customers|closure-calendar|operational-report|staff-profile|staff-notifications|staff-help|staff-status)\.html$ pages/staff/$1.html [R=302,L,NE]
RewriteRule ^(audit-log|financial-report|payment-reconciliation|sensitive-approvals|staff-accounts|system-parameters)\.html$ pages/superadmin/$1.html [R=302,L,NE]

# Rute aplikasi PHP tetap melalui front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
